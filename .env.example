# Скопируйте в .env и заполните. Файл .env не коммитится.

# Сервер
PORT=8787
HOST=0.0.0.0
BASE_URL=https://leads.example.ru        # публичный адрес (нужен для ссылок отписки, вебхуков и OAuth)
TRUST_PROXY=true                         # true только если перед приложением стоит Caddy/Nginx
DEMO_MODE=false                          # true — демо-кабинет с тестовой воронкой
ALLOW_SIGNUP=false                       # true — свободная регистрация (SaaS), иначе только по приглашениям

# Безопасность. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEADMEET_MASTER_KEY=
SESSION_DAYS=14
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# Claude (письма глубже под человека, разбор звонков)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# hh.ru — зарегистрируйте приложение на https://dev.hh.ru и укажите название + email
HH_USER_AGENT=LeadmeetOS/1.0 (you@domain.ru)

# Telegram-бот для уведомлений (@BotFather → токен; chat_id — напишите боту и откройте https://api.telegram.org/bot<токен>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЕГРЮЛ через DaData (бесплатный ключ на dadata.ru)
DADATA_API_KEY=

# Транскрибация звонков: openai (или любой совместимый, TRANSCRIBE_URL) | deepgram
TRANSCRIBE_PROVIDER=
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=

# Вход через Google / Яндекс ID / VK ID (необязательно). Redirect: {BASE_URL}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
